<!DOCTYPE html>
<html lang="de">

<head>

<meta charset="UTF-8">

<meta
  name="viewport"
  content="width=device-width, initial-scale=1, viewport-fit=cover">

<title>Samaels 1. Geburtstag</title>

<meta
  name="theme-color"
  content="#dce7ed">

<style>

* {
  box-sizing: border-box;
}

:root {
  --background: #f7f4ee;
  --white: #ffffff;
  --text: #252525;
  --muted: #77736d;
  --blue: #91a9ba;
  --blue-dark: #647f91;
}

html {
  scroll-behavior: smooth;
}

body {

  margin: 0;

  font-family:
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    Roboto,
    Arial,
    sans-serif;

  background: var(--background);

  color: var(--text);
}


/* HERO */

.hero {

  min-height: 340px;

  padding:
    calc(55px + env(safe-area-inset-top))
    20px
    55px;

  display: flex;

  flex-direction: column;

  justify-content: center;

  text-align: center;

  position: relative;

  overflow: hidden;

  background:

    radial-gradient(
      circle at 20% 10%,
      rgba(255,255,255,.9),
      transparent 30%
    ),

    linear-gradient(
      145deg,
      #dce7ed,
      #edf0e8 52%,
      #f3e8dd
    );
}


.hero::before {

  content: "🎈";

  position: absolute;

  left: 7%;

  top: 35px;

  font-size: 48px;

  opacity: .22;

  transform: rotate(-15deg);
}


.hero::after {

  content: "🎈";

  position: absolute;

  right: 8%;

  bottom: 40px;

  font-size: 40px;

  opacity: .18;

  transform: rotate(12deg);
}


.number {

  width: 78px;

  height: 78px;

  margin: 0 auto 22px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 50%;

  background: rgba(255,255,255,.82);

  backdrop-filter: blur(12px);

  box-shadow:
    0 12px 35px rgba(0,0,0,.07);

  font-size: 38px;

  font-weight: 700;

  color: var(--blue-dark);
}


.hero h1 {

  margin: 0;

  font-size:
    clamp(34px, 7vw, 58px);

  letter-spacing: -2px;

  line-height: 1.04;
}


.hero p {

  max-width: 620px;

  margin: 18px auto 0;

  font-size: 17px;

  line-height: 1.65;

  color: #555;
}


/* MAIN */

main {

  width: min(
    1500px,
    calc(100% - 24px)
  );

  margin: auto;

  padding:
    35px 0
    70px;
}


.toolbar {

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 15px;

  margin-bottom: 20px;
}


.count {

  font-size: 14px;

  color: var(--muted);

  font-weight: 500;
}


.hint {

  font-size: 13px;

  color: var(--muted);
}


/* GALLERY */

.gallery {

  display: grid;

  grid-template-columns:
    repeat(
      auto-fill,
      minmax(230px, 1fr)
    );

  gap: 12px;
}


.photo {

  aspect-ratio: 1 / 1;

  position: relative;

  overflow: hidden;

  border-radius: 16px;

  background: #e4e4e4;

  cursor: pointer;

  box-shadow:
    0 3px 10px rgba(0,0,0,.04);

  transform: translateZ(0);

  transition:
    transform .2s ease,
    box-shadow .2s ease;
}


.photo:hover {

  transform: translateY(-3px);

  box-shadow:
    0 12px 30px rgba(0,0,0,.10);
}


.photo img {

  width: 100%;

  height: 100%;

  object-fit: cover;

  display: block;

  transition:
    transform .35s ease;
}


.photo:hover img {

  transform: scale(1.03);
}


.download-small {

  position: absolute;

  right: 10px;

  bottom: 10px;

  width: 42px;

  height: 42px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 50%;

  background: rgba(255,255,255,.92);

  color: #222;

  text-decoration: none;

  font-size: 20px;

  font-weight: bold;

  backdrop-filter: blur(10px);

  box-shadow:
    0 4px 15px rgba(0,0,0,.16);
}


/* LOADING */

.loading {

  min-height: 300px;

  display: flex;

  flex-direction: column;

  justify-content: center;

  align-items: center;

  gap: 16px;

  color: var(--muted);
}


.spinner {

  width: 42px;

  height: 42px;

  border: 4px solid #ddd;

  border-top-color: var(--blue-dark);

  border-radius: 50%;

  animation:
    spin .8s linear infinite;
}


@keyframes spin {

  to {
    transform: rotate(360deg);
  }

}


/* LIGHTBOX */

.lightbox {

  position: fixed;

  inset: 0;

  z-index: 9999;

  display: none;

  align-items: center;

  justify-content: center;

  flex-direction: column;

  background: rgba(8,8,8,.97);

  padding:
    env(safe-area-inset-top)
    env(safe-area-inset-right)
    env(safe-area-inset-bottom)
    env(safe-area-inset-left);
}


.lightbox.active {

  display: flex;
}


.light-image {

  max-width: 94vw;

  max-height: 78vh;

  object-fit: contain;
}


.close {

  position: fixed;

  top:
    calc(15px + env(safe-area-inset-top));

  right: 15px;

  width: 48px;

  height: 48px;

  border: 0;

  border-radius: 50%;

  background: rgba(255,255,255,.14);

  color: white;

  font-size: 28px;

  cursor: pointer;

  backdrop-filter: blur(12px);

  z-index: 3;
}


.arrow {

  position: fixed;

  top: 50%;

  transform: translateY(-50%);

  width: 50px;

  height: 68px;

  border: 0;

  border-radius: 13px;

  background: rgba(255,255,255,.12);

  color: white;

  font-size: 34px;

  cursor: pointer;

  backdrop-filter: blur(10px);
}


.left {
  left: 14px;
}

.right {
  right: 14px;
}


.light-bottom {

  display: flex;

  flex-direction: column;

  align-items: center;

  gap: 12px;

  margin-top: 17px;
}


.counter {

  font-size: 13px;

  color: rgba(255,255,255,.66);
}


.download-button {

  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 9px;

  padding: 13px 23px;

  min-width: 190px;

  border-radius: 30px;

  background: white;

  color: #222;

  text-decoration: none;

  font-weight: 650;

  box-shadow:
    0 5px 25px rgba(0,0,0,.3);
}


/* ERROR */

.error {

  padding: 40px 20px;

  text-align: center;

  border-radius: 18px;

  background: white;

  color: #555;
}


/* FOOTER */

footer {

  text-align: center;

  padding:
    20px 20px
    calc(40px + env(safe-area-inset-bottom));

  color: #8a8782;

  font-size: 13px;
}


/* MOBILE */

@media(max-width: 600px) {

  .hero {

    min-height: 310px;

    padding-left: 22px;

    padding-right: 22px;
  }


  main {

    width: calc(100% - 12px);

    padding-top: 23px;
  }


  .toolbar {

    padding: 0 5px;
  }


  .gallery {

    grid-template-columns:
      repeat(2, 1fr);

    gap: 5px;
  }


  .photo {

    border-radius: 7px;
  }


  .download-small {

    right: 6px;

    bottom: 6px;

    width: 37px;

    height: 37px;

    font-size: 17px;
  }


  .light-image {

    max-width: 100vw;

    max-height: 72vh;
  }


  .arrow {

    top: auto;

    bottom:
      calc(
        85px +
        env(safe-area-inset-bottom)
      );

    transform: none;
  }


  .left {
    left: 18px;
  }


  .right {
    right: 18px;
  }

}

</style>

</head>


<body>


<header class="hero">

  <div class="number">
    1
  </div>

  <h1>
    Samaels 1. Geburtstag
  </h1>

  <p>
    Ein ganz besonderer Tag und viele wunderschöne Erinnerungen. ❤️
    <br>
    Hier könnt ihr euch die Fotos ansehen und eure Lieblingsbilder herunterladen.
  </p>

</header>



<main>

  <div class="toolbar">

    <div
      id="count"
      class="count">
    </div>

    <div class="hint">
      Foto antippen zum Vergrößern
    </div>

  </div>


  <div
    id="loading"
    class="loading">

    <div class="spinner"></div>

    <div>
      Fotos werden geladen …
    </div>

  </div>


  <div
    id="gallery"
    class="gallery">
  </div>

</main>



<footer>
  Danke, dass ihr diesen besonderen Tag mit uns gefeiert habt. 🤍
</footer>



<div
  id="lightbox"
  class="lightbox">


  <button
    class="close"
    onclick="closeLightbox()">
    ×
  </button>


  <button
    class="arrow left"
    onclick="previousPhoto()">
    ‹
  </button>


  <img
    id="lightImage"
    class="light-image"
    alt="Samaels 1. Geburtstag">


  <button
    class="arrow right"
    onclick="nextPhoto()">
    ›
  </button>


  <div class="light-bottom">

    <div
      id="photoCounter"
      class="counter">
    </div>


    <a
      id="downloadButton"
      class="download-button"
      href="#"
      target="_blank"
      rel="noopener">

      ↓ Foto herunterladen

    </a>

  </div>

</div>



<script>

/* ==============================================
   HIER DEINE APPS-SCRIPT-WEB-APP-URL EINTRAGEN
   ============================================== */

const API_URL =
  'https://script.google.com/a/macros/bsb3100.at/s/AKfycbyjZ3nhws9i3m61IWaA0_AZvt3rlhAoI7gwPBxKi1LeTVx0t-3adoTVX07NHOGZwog/exec?api=photos';



let photos = [];

let currentIndex = 0;

let touchStartX = 0;



async function loadPhotos() {

  try {

    const response =
      await fetch(
        API_URL,
        {
          cache: 'no-store'
        }
      );


    if (!response.ok) {

      throw new Error(
        'HTTP ' +
        response.status
      );

    }


    photos =
      await response.json();


    renderPhotos();


  } catch (error) {

    console.error(error);


    document
      .getElementById('loading')
      .innerHTML = `

        <div class="error">

          <strong>
            Die Fotos konnten leider nicht geladen werden.
          </strong>

          <br><br>

          Bitte versucht es später noch einmal.

        </div>

      `;

  }

}



function renderPhotos() {

  const gallery =
    document.getElementById('gallery');


  const loading =
    document.getElementById('loading');


  loading.style.display =
    'none';


  document
    .getElementById('count')
    .textContent =

    photos.length +
    (
      photos.length === 1
      ? ' Foto'
      : ' Fotos'
    );


  if (!photos.length) {

    gallery.innerHTML = `

      <div class="error">

        Momentan sind noch keine Fotos verfügbar.

      </div>

    `;

    return;

  }


  photos.forEach(
    (photo, index) => {


      const item =
        document.createElement('div');


      item.className =
        'photo';



      const img =
        document.createElement('img');


      img.src =
        photo.thumb;


      img.alt =
        'Samaels 1. Geburtstag';


      img.loading =
        'lazy';


      img.addEventListener(
        'click',
        () =>
          openLightbox(index)
      );



      const download =
        document.createElement('a');


      download.className =
        'download-small';


      download.href =
        photo.download;


      download.target =
        '_blank';


      download.rel =
        'noopener';


      download.innerHTML =
        '↓';


      download.title =
        'Foto herunterladen';


      download.addEventListener(
        'click',
        event =>
          event.stopPropagation()
      );



      item.appendChild(img);

      item.appendChild(download);

      gallery.appendChild(item);

    }
  );

}



function openLightbox(index) {

  currentIndex =
    index;


  updateLightbox();


  document
    .getElementById('lightbox')
    .classList
    .add('active');


  document.body.style.overflow =
    'hidden';

}



function closeLightbox() {

  document
    .getElementById('lightbox')
    .classList
    .remove('active');


  document.body.style.overflow =
    '';

}



function updateLightbox() {

  if (!photos[currentIndex]) {
    return;
  }


  const photo =
    photos[currentIndex];


  document
    .getElementById('lightImage')
    .src =
    photo.full;


  document
    .getElementById('downloadButton')
    .href =
    photo.download;


  document
    .getElementById('photoCounter')
    .textContent =

    `${currentIndex + 1} / ${photos.length}`;

}



function nextPhoto() {

  currentIndex =
    (
      currentIndex + 1
    ) % photos.length;


  updateLightbox();

}



function previousPhoto() {

  currentIndex =
    (
      currentIndex - 1 +
      photos.length
    ) % photos.length;


  updateLightbox();

}



document.addEventListener(
  'keydown',
  event => {

    const lightbox =
      document.getElementById(
        'lightbox'
      );


    if (
      !lightbox.classList.contains(
        'active'
      )
    ) {
      return;
    }


    if (
      event.key === 'Escape'
    ) {
      closeLightbox();
    }


    if (
      event.key === 'ArrowRight'
    ) {
      nextPhoto();
    }


    if (
      event.key === 'ArrowLeft'
    ) {
      previousPhoto();
    }

  }
);



const lightbox =
  document.getElementById(
    'lightbox'
  );


lightbox.addEventListener(
  'touchstart',
  event => {

    touchStartX =
      event.changedTouches[0]
        .screenX;

  },
  {
    passive: true
  }
);



lightbox.addEventListener(
  'touchend',
  event => {

    const touchEndX =
      event.changedTouches[0]
        .screenX;


    const difference =
      touchStartX -
      touchEndX;


    if (
      Math.abs(difference) < 50
    ) {
      return;
    }


    if (
      difference > 0
    ) {

      nextPhoto();

    } else {

      previousPhoto();

    }

  },
  {
    passive: true
  }
);



loadPhotos();

</script>


</body>

</html>
